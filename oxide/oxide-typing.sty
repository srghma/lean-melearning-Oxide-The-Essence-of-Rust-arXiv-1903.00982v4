\newcommand{\TFunction}{
  \inferrule[T-Function]{
    %% premises
    \oxlookup{\oxglobalctx}{\oxfnname}{
      \oxfuncdef{\oxfnname}{
        \overline{\oxenvvar} \oxcomma \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
      }{
        \oxascribe{\oxid_1}{\oxsitype_1} \oxdotsc
        \oxascribe{\oxid_n}{\oxsitype_n}
      }{\oxsitype_r}{\overline{\oxabsprov_1: \oxabsprov_2}}{\oxexpr}
    } \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{\oxfnname}{
      \oxtfunext{
        \overline{\oxenvvar} \oxcomma \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
      }{
        \oxsitype_1 \oxdotsc \oxsitype_n
      }{\oxsitype_r}{}{\overline{\oxabsprov_1: \oxabsprov_2}}
    }{\oxvarctx}
  }
}

\newcommand{\TClosure}{
  \inferrule[T-Closure]{
    %% premises
    \oxfvars{\oxexpr} \setminus \overline{\oxid} = \overline{\oxid_f} \\
    \oxfncvars{\oxvarctx}{\oxexpr} \setminus \overline{\oxid} = \overline{\oxid_{nc}} \\\\
    \overline{\oxcprov} = \overline{\oxfprovs{\oxvarctx(\oxid_f)}} \oxcomma (\oxfprovs{\oxexpr} \setminus (\overline{\oxfprovs{\oxsitype}}, \oxfprovs{\oxsitype_r}))  \\\\
    \oxframe_c = \overline{\oxloanctxentry{\oxcprov}{\oxvarctx(\oxcprov)}} \oxcomma
    \overline{\oxvarctxentry{\oxid_f}{\oxvarctx(\oxid_f)}} \\
    \forall \oxcprov_p \in \underset{i=1}{\overset{n}{\bigcup}} \; \oxfprovs{\oxsitype_i} \cup
    \oxfprovs{\oxsitype_r}. \; \oxlookup{\oxvarctx}{\oxcprov_p}{\emptyset} \\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}
    {
      \oxnewframe{
        \oxtupdatemany{\oxvarctx}{\oxid_{nc}}{\oxtuninit{\oxvarctx(\oxid_{nc})}}
      }{
        \oxframe_c \oxcomma
        \oxvarctxentry{\oxid_1}{\oxsitype_1}
        \oxdotsc
        \oxvarctxentry{\oxid_n}{\oxsitype_n}
      }
    }{
      \oxexpr
    }{\oxsitype_r}{\oxnewframe{\oxvarctx^\prime}{\oxframe}} \\
  }{
    %% conclusions
    \begin{array}{rr}
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxclosure{
        \oxascribe{\oxid_1}{\oxsitype_1} \oxdotsc
        \oxascribe{\oxid_n}{\oxsitype_n}
      }{\oxsitype_r}{
        \oxexpr
      }
    }{
      \oxtclosure{
        \oxsitype_1 \oxdotsc \oxsitype_n
      }{\oxsitype_r}{\oxframe_c}
      }{\oxvarctx^\prime}
      \end{array}
  }
}

\newcommand{\TApp}{
  \inferrule[T-AppFunction]{
    %% premises
    \overline{\oxenvwellformed{\oxglobalctx}{\oxtvarctx}{\oxvarctx}{\oxenv}} \\
    \overline{\oxrgnvalidity{\oxtvarctx}{\oxvarctx}{\oxprov}} \\
    \overline{\oxtypevalidity{\oxglobalctx}{\oxtvarctx}{\oxvarctx}{\oxsitype}} \\
    \delta = \oxsubstmany{
      \oxsubstmany{
        \oxsubstmany{\cdot}{\oxenv}{\oxenvvar}
      }{\oxprov}{\oxabsprov}
    }{\oxsitype}{\oxtvar} \\\\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr_f
    }{
      \oxtfunext{
        \overline{\oxenvvar} \oxcomma \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
      }{
        \oxsitype_1 \oxdotsc \oxsitype_n
      }{\oxsitype_f}{}{\overline{\oxabsprov_1: \oxabsprov_2}}
    }{\oxvarctx_0} \\\\
    \forall i \in \oxset{1 \oxdots n}. \;
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{
      \oxextendctx{\oxkontctx}{
        \delta(\oxsitype_1) \oxdots \delta(\oxsitype_{i-1})
      }
    }{\oxvarctx_{i-1}}{
      \oxexpr_i
    }{
      \delta(\oxsitype_i)
    }{\oxvarctx_i} \\
    \forall i \in \oxset{ 1 \oxdots n }. \;
    \forall \oxcprov \in \oxfprovs{\oxsitype_i}. \;
    \oxnotreborrowed{\oxvarctx_n^\prime}{\oxcprov} \\
    \oxrunifymany{\oxtvarctx}{\oxkontctx}{\oxvarctx_n}{
      \oxsubstmany{\oxabsprov_2}{\oxprov}{\oxabsprov}
    }{
      \oxsubstmany{\oxabsprov_1}{\oxprov}{\oxabsprov}
    }{\oxvarctx_b} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxapp{\oxexpr_f}{
        \overline{\oxenv} \oxcomma \overline{\oxprov} \oxcomma \overline{\oxsitype}
      }{
        \oxexpr_1 \oxdotsc \oxexpr_n
      }
    }{
      \delta(\oxsitype_f)
    }{\oxvarctx_b}
  }
}

\newcommand{\TAppClosure}{
  \inferrule[T-AppClosure]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr_f
    }{
      \oxtfun{}{
        \oxsitype_1 \oxdotsc \oxsitype_n
      }{\oxsitype_f}{\oxenv_c}
    }{\oxvarctx_0} \\\\
    \forall i \in \oxset{1 \oxdots n}. \;
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{
      \oxextendctx{\oxkontctx}{
        \oxsitype_1 \oxdots \oxsitype_{i-1}
      }
    }{\oxvarctx_{i-1}}{
      \oxexpr_i
    }{
      \oxsitype_{i^\prime}
    }{\oxvarctx_i} \\
    \oxtunify[\oxcombineunrest]{\oxtvarctx}{\oxkontctx}{\oxvarctx_i}
    {\oxsitype_{i^\prime}}{\oxsitype_i}{\oxvarctx_i^\prime} \\\\
    \forall i \in \oxset{ 1 \oxdots n }. \;
    \forall \oxcprov \in \oxfprovs{\oxsitype_i}. \;
    \oxnotreborrowed{\oxvarctx_n^\prime}{\oxcprov} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxapply{\oxexpr_f}{
        \oxexpr_1 \oxdotsc \oxexpr_n
      }
    }{
      \oxsitype_f
    }{\oxvarctx_n^\prime}
  }
}

