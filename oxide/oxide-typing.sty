}

\newcommand{\TAssign}{
  \inferrule[T-Assign]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr
    }{\oxsitype}{\oxvarctx_1} \\
    \oxvarctx_1(\oxplace) = \oxsxtype \\
    \oxsxtype = \oxtref{\oxcprov}{\oxmuta}{\oxxitype} \implies
    \oxrgnuniqueto{\oxcprov}{\oxplace}{\oxvarctx_1} \\
    \oxtunify[\oxnoop]{\oxtvarctx}{\oxkontctx}{
      \oxrsub{\oxvarctx_1}{\oxderef{\oxplace}}
    }{\oxsitype}{\oxsxtype}{\oxvarctx^\prime} \\
    (\oxsxtype = \oxsdtype \vee
    \oxmusafety{\oxtvarctx}{\oxkontctx}{\oxvarctx^\prime}{\oxmut}{\oxplace}{
      \oxset{\oxloanpkg{\oxmut}{\oxplace}}
    }) \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxassign{\oxplace}{\oxexpr}
    }{\oxtunit}{
      \oxtupdate{\oxvarctx^\prime}{\oxplace}{\oxsitype}
    }
  }
}

