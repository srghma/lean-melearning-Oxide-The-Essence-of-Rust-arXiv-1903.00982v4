%%%%%%%%%%%%%%%%%%%
%% Judgment Form %%
%%%%%%%%%%%%%%%%%%%

\newcommand{\oxtypjudgeraw}[4]{
  \ensuremath{#1 \vdash #2 : #3 \Rightarrow #4}
}

\newcommand{\oxtypjudge}[7]{
  \oxtypjudgeraw{#1; \, #2; \, #4; \, #3}{\framebox{$#5$}}{#6}{#7}
}

\newcommand{\oxtypjudgeOLD}[8]{
  \oxtypjudgeraw{#1; \, #2; \, #3 \oxenvsep #4}{\framebox{$#5$}}{#6}{#7 \oxenvsep #8}
}

\newcommand{\oxtypjudgenobox}[7]{
  \oxtypjudgeraw{#1; \, #2; \, #4; \, #3}{#5}{#6}{#7}
}

\newcommand{\oxtypjudgeshape}{
  \ensuremath{
    \oxtypjudgenobox{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr
    }{\oxtype}{\oxvarctx^\prime}
  }
}

\newcommand{\oxtypjudgeform}{
  \framebox{\oxtypjudgeshape}
}

\newcommand{\oxshapetype}[6]{
  \ensuremath{
    #1; \, #2; \, #3 \vdash \oxstoreentry{#4}{#5} : #6
  }
}

\newcommand{\oxshapetypeform}{
  \framebox{
    \oxshapetype{\oxglobalctx}{\oxtvarctx}{\oxvarctx}{\oxplace}{\oxshape}{\oxtype}
  }
}

\newcommand{\oxvaluetype}[4]{
  \ensuremath{
    #1 \vdash #2 <: #3 \leadsto #4
  }
}

\newcommand{\oxvaluetypeform}{
  \framebox{\oxvaluetype{\oxglobalctx}{\oxvalue}{\oxtype}{\oxsub}}
}

\newcommand{\oxrelatedsub}[2]{
  \ensuremath{
    #1 <: #2
  }
}

\newcommand{\oxrelatedsubform}{
  \framebox{\oxrelatedsub{\oxsub^\prime}{\oxsub}}
}

\newcommand{\oxrelatedenv}[3]{
  \ensuremath{#1 \vdash #2 \rhd #3}
}

\newcommand{\oxrelatedenvform}{
  \framebox{\oxrelatedenv{\oxglobalctx}{\oxvarctx^\prime}{\oxvarctx}}
}

%%%%%%%%%%%%%%%%%%
%% Typing Rules %%
%%%%%%%%%%%%%%%%%%

\newcommand{\TDrop}{
  \inferrule[T-Drop]{
    %% premises
    \oxlookup{\oxvarctx}{\oxplace}{\oxsitype_\oxplace} \\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{
      \oxvarctx[\oxplace \mapsto \oxsidtype_\oxplace]
    }{\oxexpr}{\oxsxtype}{\oxvarctx_f} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr
    }{\oxsxtype}{\oxvarctx_f}
  }
}

\newcommand{\TGCLoans}{
  \inferrule[T-GarbageCollectLoans]{
    %% premises
    \oxcprov\text{ does not occur in } \oxsxtype \\
    \forall \oxplace \in \oxdomain{\oxvarctx}, \ \oxcprov\text{ does not occur in }\oxvarctx(\oxplace) \\\\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{
      \oxvarctx[\oxcprov \mapsto \emptyset]
    }{\oxexpr}{\oxsxtype}{\oxvarctx_f}
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxvarctx}{\oxexpr}{\oxsxtype}{\oxvarctx_f}
  }
}

\newcommand{\TBorrow}{
  \inferrule[T-Borrow]{
    %% premises
    \oxlookup{\oxvarctx}{\oxcprov}{\emptyset} \\
    \oxnotinclosure{\oxkontctx}{\oxvarctx}{\oxcprov} \\\\
    \oxmusafety{\oxtvarctx}{\oxkontctx}{\oxvarctx}{\oxmuta}{\oxplaceexpr}{
      \oxset{\overline{\oxloan}}
    } \\
    \oxcomputetynoprov{\oxtvarctx}{\oxvarctx}{\oxmuta}{\oxplaceexpr}{\oxxitype} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxref{\oxcprov}{\oxmuta}{\oxplaceexpr}
    }{
      \oxtref{\oxcprov}{\oxmuta}{\oxxitype}
    }{
      \oxupdate{\oxvarctx}{
        \oxloanctxentry{\oxcprov}{
          \oxset{\overline{\oxloan}}
        }
      }
    }
  }
}

\newcommand{\TBorrowIndex}{
  \inferrule[T-BorrowIndex]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}
    {\oxexpr}{\oxtnum}{\oxvarctx^\prime} \\
    \oxlookup{\oxvarctx^\prime}{\oxcprov}{\emptyset} \\
    \oxnotinclosure{\oxkontctx}{\oxvarctx^\prime}{\oxcprov} \\\\
    \oxmusafety{\oxtvarctx}{\oxkontctx}{\oxvarctx^\prime}{\oxmuta}{
      \oxplaceexpr
    }{
      \oxset{\overline{\oxloan}}
    } \\
    \oxcomputetynoprov{\oxtvarctx}{\oxvarctx^\prime}{\oxmuta}{\oxplaceexpr}{\oxxitype} \\\\
    \oxxitype = \oxtarr{\oxsitype}{\oxnum} \vee \oxxitype =
    \oxtslice{\oxsitype} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxref{\oxcprov}{\oxmuta}{\oxindex{\oxplaceexpr}{\oxexpr}}
    }{
      \oxtref{\oxcprov}{\oxmuta}{\oxsitype}
    }{
      \oxupdate{\oxvarctx^\prime}{
        \oxloanctxentry{\oxcprov}{
          \oxset{\overline{\oxloan}}
        }
      }
    }
  }
}

\newcommand{\TBorrowSlice}{
  \inferrule[T-BorrowSlice]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}
    {\oxexpr_1}{\oxtnum}{\oxvarctx_1} \\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx_1}
    {\oxexpr_2}{\oxtnum}{\oxvarctx_2} \\\\
    \oxlookup{\oxvarctx_2}{\oxcprov}{\emptyset} \\
    \oxnotinclosure{\oxkontctx}{\oxvarctx_2}{\oxcprov} \\
    \oxmusafety{\oxtvarctx}{\oxkontctx}{\oxvarctx_2}{\oxmuta}{\oxplaceexpr}{
      \oxset{\overline{\oxloan}}
    } \\
    \oxcomputetynoprov{\oxtvarctx}{\oxvarctx_2}{\oxmuta}{\oxplaceexpr}{\oxtslice{\oxsitype}}
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxref{\oxcprov}{\oxmuta}{\oxslice{\oxplaceexpr}{\oxexpr_1}{\oxexpr_2}}
    }{
      \oxtref{\oxcprov}{\oxmuta}{\oxtslice{\oxsitype}}
    }{
      \oxupdate{\oxvarctx_2}{
        \oxloanctxentry{\oxcprov}{
          \oxset{\overline{\oxloan}}
        }
      }
    }
  }
}

\newcommand{\TSeq}{
  \inferrule[T-Seq]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr_1
    }{\oxsitype_1}{\oxvarctx_1} \\\\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{
      \oxgcloans{\oxkontctx}{\oxvarctx_1}
    }{
      \oxexpr_2
    }{\oxsitype_2}{\oxvarctx_2} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxseq{\oxexpr_1}{\oxexpr_2}
    }{\oxsitype_2}{\oxvarctx_2}
  }
}

\newcommand{\TIndexCopy}{
  \inferrule[T-IndexCopy]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{\oxexpr}
    {\oxtnum}{\oxvarctx^\prime} \\
    \oxmusafety{\oxtvarctx}{\oxkontctx}{\oxvarctx^\prime}{\oximm}
    {\oxplaceexpr}{
      \oxset{\overline{\oxloan}}
    } \\\\
    \oxcomputetynoprov{\oxtvarctx}{\oxvarctx^\prime}{\oximm}{\oxplaceexpr}{\oxxitype} \\
    \oxxitype = \oxtarr{\oxsitype}{\oxnum} \vee \oxxitype = \oxtslice{\oxsitype} \\
    \oxcopyable{\oxglobalctx}{\oxsitype} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{
      \oxvarctx
    }{
      \oxindex{\oxplaceexpr}{\oxexpr}
    }{\oxsitype}{\oxvarctx^\prime}
  }
}

\newcommand{\TBranch}{
  \inferrule[T-Branch]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr_1
    }{\oxtbool}{\oxvarctx_1} \\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx_1}{
      \oxexpr_2
    }{\oxsitype_2}{\oxvarctx_2} \\\\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx_1}{
      \oxexpr_3
    }{\oxsitype_3}{\oxvarctx_3} \\
    \oxsitype = \oxsitype_2 \vee \oxsitype = \oxsitype_3 \\\\
    \oxtunify[\oxcombine]{\oxtvarctx}{\oxkontctx}{\oxvarctx_2}
    {\oxsitype_2}{\oxsitype}{\oxvarctx_2^\prime} \\
    \oxtunify[\oxcombine]{\oxtvarctx}{\oxkontctx}{\oxvarctx_3}
    {\oxsitype_3}{\oxsitype}{\oxvarctx_3^\prime} \\
    \oxvarctx_2^\prime \oxintersect \oxvarctx_3^\prime = \oxvarctx^\prime \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxbranch{\oxexpr_1}{\oxexpr_2}{\oxexpr_3}
    }{\oxsitype}{\oxvarctx^\prime}
  }
}

\newcommand{\TMove}{
  \inferrule[T-Move]{
    %% premises
    \oxmusafety{\oxtvarctx}{\oxkontctx}{\oxvarctx}{\oxmut}{\oxplace}{
      \oxset{\oxloanpkg{\oxmut}{\oxplace}}
    } \\\\
    \oxlookup{\oxvarctx}{\oxplace}{\oxsitype} \\
    \oxnoncopyable{\oxglobalctx}{\oxsitype} \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{
      \oxvarctx
    }{
      \oxplace
    }{\oxsitype}{\oxtupdate{\oxvarctx}{\oxplace}{\oxsidtype}}
  }
}

