\newcommand{\TLet}{
  \inferrule[T-Let]{
    %% premises
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxexpr_1
    }{\oxsitype_1}{\oxvarctx_1} \\
    \oxtunify[\oxcombine]{\oxtvarctx}{\oxkontctx}{\oxvarctx_1}
    {\oxsitype_1}{\oxsitype_a}{\oxvarctx_1^\prime} \\
    \forall \oxcprov \in \oxfprovs{\oxsitype_a}. \;
    \oxnotreborrowed{\oxvarctx_1^\prime}{\oxcprov} \\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{
      \oxgcloans{\oxkontctx}{
        \oxextendctx{\oxvarctx_1^\prime}{\oxvarctxentry{\oxid}{\oxsitype_a}}
      }
    }{
      \oxexpr_2
    }{\oxsitype_2}{
      \oxextendctx{\oxvarctx_2}{
        \oxvarctxentry{\oxid}{\oxsdtype}
      }
    } \\
  }{
    %% conclusions
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxkontctx}{\oxvarctx}{
      \oxlet{\oxid}{\oxsitype_a}{\oxexpr_1}{\oxexpr_2}
    }{\oxsitype_2}{
      \oxvarctx_2
    }
  }
}

