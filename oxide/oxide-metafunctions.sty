\newcommand{\oxgcloans}[2]{
  \textrm{gc-loans}_{#1}(#2)
}

\newcommand{\oxgcloansform}{
  \framebox{$\oxgcloans{\oxkontctx}{\oxvarctx}$}
}

\newcommand{\Defgcloans}{
  $\oxgcloans{\oxkontctx}{\oxvarctx} = \oxvarctx[\overline{\oxcprov \mapsto \emptyset}]$ \\
  \quad where $\overline{\oxcprov} = \oxset{\oxcprov \in \oxdomain{\oxvarctx} \ | \ \forall \oxtype
    \in \oxcodomain{\oxkontctx} \cup \oxcodomain{\oxvarctx}. \; \oxcprov \text{ does not occur in } \oxtype}$
}

\newcommand{\oxrsubform}{
  \framebox{$\oxrsub{\oxvarctx}{\oxplaceexpr}$}
}

\newcommand{\Defrsub}{ $\oxrsub{\oxvarctx}{\oxplaceexpr} = \oxvarctx^\prime$ where $\oxdomain{\oxvarctx} = \oxdomain{\oxvarctx^\prime}$ and \\
  $\forall \oxcprov. \; \oxvarctx^\prime(\oxcprov) =
  \oxset{\oxloanpkg{\oxmuta}{\oxplaceexpr^\prime} \in \oxvarctx(\oxcprov) \ | \ \oxplaceexpr^\prime \neq
    \oxplaceexprctx[\oxplaceexpr]}$ and \\
  $\forall \oxplace. \; \oxvarctx(\oxplace) = \oxvarctx^\prime(\oxplace)$
}

\newcommand{\oxrsubmanyform}{
  \framebox{$\oxrsub{\oxvarctx}{\oxset{\overline{\oxplaceexpr}}}$}
}

\newcommand{\Defrsubmany}{
  $\oxrsub{\oxvarctx}{\oxset{\oxplaceexpr \oxcomma \overline{\oxplaceexpr}}} =
  \oxrsub{(\oxrsub{\oxvarctx}{\oxplaceexpr})}{\oxset{\overline{\oxplaceexpr}}}$ \\
  $\oxrsub{\oxvarctx}{\emptyset} = \oxvarctx$
}

\newcommand{\oxrgnuniquetoform}{
  \framebox{
    $\oxrgnuniqueto{\oxcprov}{\oxplace}{\oxvarctx}$
  }
}

\newcommand{\DefRgnUniqueTo}{
  $\oxrgnuniqueto{\oxcprov}{\oxplace}{\oxvarctx} = \forall \oxvarctxentry{\oxplace^\prime}{\oxtref{\oxcprov^\prime}{\oxmuta^\prime}{\oxxitype_2}}
  \in \oxexplode{\oxvarctx}. \;
  \oxplace = \oxplace^\prime \vee \oxcprov \neq \oxcprov^\prime$
}

\newcommand{\oxloanmappings}[2]{\textrm{regions}(#1,\ #2)}

\newcommand{\oxloanmappingsform}{
  \framebox{
    $\oxloanmappings{\oxvarctx}{\oxkontctx} = \oxset{\overline{\oxcprov \mapsto \oxset{\oxloans}}}$
  }
}

\newcommand{\Defoxloanmappings}{
  $\oxloanmappings{\oxvarctx}{\oxkontctx} = \oxset{\oxcprov \mapsto \oxset{\oxloans} \in \oxvarctx} \cup
  \oxset{\oxcprov \mapsto \oxset{\oxloans} \in \oxframe_c \ | \ \exists \oxxitype \in \oxvarctx \vee \exists \oxxitype \in \oxkontctx.\
    \oxtycontains{\oxtclosure{
        \oxsitype_1 \oxdotsc \oxsitype_n
      }{\oxsitype_r}{\oxframe_c}
  }{\oxxitype}} $
}

