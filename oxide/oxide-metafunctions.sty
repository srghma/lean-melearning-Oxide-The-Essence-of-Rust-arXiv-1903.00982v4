%% Definition of in rightmost frame %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


\newcommand{\oxinrightmost}[2]{#1 \texttt{ in rightmost frame of }#2}

\newcommand{\oxinrightmostform}{\framebox{
    $\oxinrightmost{\oxid}{\oxvarctx}$
  }}

\newcommand{\RMPlace}{
  \inferrule[RM-Place]{
    %% premises
    \oxvarctx = \oxnewframe{\oxvarctx_1}{\oxnewframe{\oxframe}{\oxvarctx_2}} \\
    \oxid \in \oxframe \\
    \oxid \not \in \oxvarctx_2
  }{
    %% conclusions
    \oxinrightmost{\oxid.q}{\oxvarctx}
  }
}

\newcommand{\RMPlaceExpression}{
  \inferrule[RM-PlaceExpression]{
    %% premises
    \forall \oxid \in \oxplaceexpr. \; \oxvarctx = \oxnewframe{\oxvarctx_1}{\oxnewframe{\oxframe}{\oxvarctx_2}} \wedge
    \oxid \in \oxframe \wedge
    \oxid \not \in \oxvarctx_2
  }{
    %% conclusions
    \oxinrightmost{\oxplaceexpr}{\oxvarctx}
  }
}

