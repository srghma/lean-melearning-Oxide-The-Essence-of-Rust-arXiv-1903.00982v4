\newcommand{\DProj}{
  \inferrule[D-Projection]{
    %% premises
    \oxdecompose{\oxtype_i}{\oxpath}{\oxtypectx}{\oxtype} \\
  }{
    %% conclusions
    \oxdecompose{
      \oxtprod{\oxtype_0 \oxdotsc \oxtype_i \oxdotsc \oxtype_n}
    }{\oxpathcons{i}{\oxpath}}{
      \oxtprod{\oxtype_0 \oxdotsc \oxtypectx \oxdotsc \oxtype_n}
    }
    {\oxtype}
  }
}

