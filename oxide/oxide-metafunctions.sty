\newcommand{\InLoanCtx}[3]{
  (#1 \in \oxdomain{#2} \implies
    \oxlookup{#2}{#1}{\oxset{#3}})
}

\newcommand{\InLoanCtxAbs}[2]{
  (#1 \in \oxdomain{#2} \implies
  \oxlookup{#2}{#1}{\oxabsloan})
}

\newcommand{\oxintersectform}{
  \framebox{$\oxvarctx_1 \oxintersect \oxvarctx_2$}
}

\newcommand{\DefIntersect}{
  \ensuremath{
    \begin{array}{lcl}
      (\oxvarctx_1 \oxframesep \oxframe_1) \oxintersect
      (\oxvarctx_2 \oxframesep \oxframe_2) & = &
      (\oxvarctx_1 \oxintersect \oxvarctx_2) \oxframesep
      (\oxframe_1 \oxintersect \oxframe_2) \\
      \oxemptyctx \oxintersect \oxemptyctx & = & \oxemptyctx 
    \end{array}
  }
}

\newcommand{\oxframeintersectform}{
  \framebox{$\oxframe_1 \oxintersect \oxframe_2$}
}

\newcommand{\DefFrameIntersect}{
  \ensuremath{
    \begin{array}{lcl}
      (\oxframe_1, \oxvarctxentry{\oxid}{\oxtype}) \oxintersect (\oxframe_2,
      \oxvarctxentry{\oxid}{\oxtype}) & = & (\oxframe_1 \oxintersect
      \oxframe_2), \oxvarctxentry{\oxid}{\oxtype} \\ (\oxframe_1,
      \oxloanctxentry{\oxcprov}{\oxset{\overline{\oxloan}}}) \oxintersect
      (\oxframe_2, \oxloanctxentry{\oxcprov}{\oxset{\overline{\oxloan^\prime}}}) & = &
      (\oxframe_1 \oxintersect \oxframe_2), \oxcprov \mapsto
      \oxset{\overline{\oxloan}, \overline{\oxloan^\prime}} \\
     \oxemptyctx \oxintersect \oxemptyctx & = & \oxemptyctx 
    \end{array}
  }
}

