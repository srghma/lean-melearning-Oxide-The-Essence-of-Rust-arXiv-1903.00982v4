\newcommand{\DefRelevant}{
  \oxrelevant{\oxplace_1}{\oxplace_2} = $\oxplace_1$ is not a prefix of
  $\oxplace_2$ and $\oxplace_2$ is not a prefix of $\oxplace_1$ and $\oxplace_1 \neq \oxplace_2$.
}

\newcommand{\DefPRelevant}{
  \oxrelevant{\oxplaceexpr_1}{\oxplaceexpr_2} = $\oxplaceexpr_1 = \oxplaceexprctx_1[\oxplace_1]$
  and $\oxplaceexpr_2 = \oxplaceexprctx_2[\oxplace_2]$ and $\oxrelevant{\oxplace_1}{\oxplace_2}$.
}


\newcommand{\DefFvars}{
  \oxfncvars{\oxstore}{\oxexpr} = all the variables $\oxid$ free in $\oxexpr$ which
  are bound to values in $\oxstore$ that are $\texttt{non-copyable}$. \\
  \oxfncvars{\oxvarctx}{\oxexpr} = all the variables $\oxid$ free in $\oxexpr$ which
  are bound to types in $\oxvarctx$ that are $\texttt{non-copyable}$. \\
}

