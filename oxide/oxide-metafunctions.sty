%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Definition max roots of place expression %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 

\newcommand{\DefMaxRoot}{
  \ensuremath{
    \begin{array}{l}
      \oxmaxroot{\oxid{(.\oxnum)}^*} = \oxid{(.\oxnum)}^*.\oxemptypath \\
      \oxmaxroot{\oxplaceexprctx[\oxderef{\oxid{(.\oxnum)}^*}]} = \oxid{(.\oxnum)}^*.\oxemptypath \\
    \end{array}
  }
}

\newcommand{\DefMaxRoots}{
  \ensuremath{
    \begin{array}{l}
      \oxmaxroots{\oxplaceexpr_1 \oxdotsc \oxplaceexpr_n} = \oxset{
        \oxmaxroot{\oxplaceexpr_i} $ | $ i \in \oxset{1 \oxdots n}
      } \\
    \end{array}
  }
}

