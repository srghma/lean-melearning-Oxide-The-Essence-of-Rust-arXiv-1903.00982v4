\newcommand{\VFunction}{
  \inferrule[WF-Function]{
    %% premises
    \forall \oxcprov \in \oxfprovs{\oxsitype_r}.\ \forall \oxtype^\prime \in
    \oxdomain{\oxvarctx}.\ \oxcprov\text{ does not occur outside of a closure in }\oxtype^\prime \\\\
    \oxenvwellformed{\oxglobalctx}{\oxtvarctx}{\oxvarctx}{
      \oxenv
    } \\
    \oxtypevalidity{\oxglobalctx}{
      \oxextendctx{\oxtvarctx}{
        \overline{\oxtvarctxentry{\oxenvvar}{\oxkenv}} \oxcomma
        \overline{\oxtvarctxentry{\oxabsprov}{\oxkprov}} \oxcomma
        \overline{\oxabsprov_1 \oxoutlives \oxabsprov_2} \oxcomma
        \overline{\oxtvarctxentry{\oxtvar}{\oxktype}}
      }
    }{\oxvarctx}{\oxsitype_r} \\\\
    \forall i \in \oxset{1 \oxdots n}. \; \oxtypevalidity{\oxglobalctx}{
      \oxextendctx{\oxtvarctx}{
        \overline{\oxtvarctxentry{\oxenvvar}{\oxkenv}} \oxcomma
        \overline{\oxtvarctxentry{\oxabsprov}{\oxkprov}} \oxcomma
        \overline{\oxabsprov_1 \oxoutlives \oxabsprov_2} \oxcomma
        \overline{\oxtvarctxentry{\oxtvar}{\oxktype}}
      }
    }{\oxvarctx}{\oxsitype_i} \\
  }{
    %% conclusions
    \oxtypevalidity{\oxglobalctx}{\oxtvarctx}{\oxvarctx}{
      \oxtfunext{
        \overline{\oxenvvar} \oxcomma \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
      }{
        \oxsitype_1 \oxdotsc \oxsitype_n
      }{\oxsitype_r}{\oxenv}{\overline{\oxabsprov_1 : \oxabsprov_2}}
    }
  }
}

