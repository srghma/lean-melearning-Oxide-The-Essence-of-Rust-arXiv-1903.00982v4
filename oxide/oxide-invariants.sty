%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Closure Restrictions %%
%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\CLSRegionNotIn}{
  \inferrule[CLS-RegionNotIn]{
    %% premises
    \forall \oxtype \in \oxcodomain{\oxvarctx} \cup \oxkontctx. \;
    \oxtycontains{\oxtfun{\_}{\oxsitype_1 \oxdotsc \oxsitype_n}{\oxsitype_r}{}}{\oxtype} \implies
    \oxcprov \not\in
    \underset{i=1}{\overset{n}{\bigcup}} \; \oxfprovs{\oxsitype_i} \cup \oxfprovs{\oxsitype_r} \\
  }{
    %% conclusion
    \oxnotinclosure{\oxkontctx}{\oxvarctx}{\oxcprov}
  }
}

\newcommand{\CLSRestriction}{
  \inferrule[CLS-Restriction]{
    %% premises
    \forall \oxtype \in \oxcodomain{\oxvarctx} \cup \oxkontctx. \;
    \oxtycontains{\oxtfun{\_}{\oxsitype_1 \oxdotsc \oxsitype_n}{\oxsitype_r}{}}{\oxtype} \implies \\
    (\oxset{\overline{\oxcprov}} \subseteq
    \underset{i=1}{\overset{n}{\bigcup}} \; \oxfprovs{\oxsitype_i} \cup \oxfprovs{\oxsitype_r} \vee
    (\oxset{\overline{\oxcprov}} \cap
    \underset{i=1}{\overset{n}{\bigcup}} \; \oxfprovs{\oxsitype_i} \cup \oxfprovs{\oxsitype_r}) =
    \emptyset) \\
  }{
    %% conclusion
    \oxclosrestriction{\oxkontctx}{\oxvarctx}{\overline{\oxcprov}}
  }
}
