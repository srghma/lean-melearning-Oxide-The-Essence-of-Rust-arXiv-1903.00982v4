\newcommand{\WFFunctionDefn}{
  \inferrule[WF-FunctionDefinition]{
    %% premises
    \oxtvarctx =
    \overline{\oxtvarctxentry{\oxenvvar}{\oxkenv}} \oxcomma
    \overline{\oxtvarctxentry{\oxabsprov}{\oxkprov}} \oxcomma
    \overline{\oxabsprov_1 \oxoutlives \oxabsprov_2} \oxcomma
    \overline{\oxtvarctxentry{\oxtvar}{\oxktype}} \\
    \oxset{\overline{\oxabsprov_1}} \subseteq \oxset{\overline{\oxabsprov}} \\
    \oxset{\overline{\oxabsprov_2}} \subseteq \oxset{\overline{\oxabsprov}} \\\\
    \oxtypjudge{\oxglobalctx}{\oxtvarctx}{\oxemptyctx}{
      \oxnewframe{\oxemptyctx}
      {\oxvarctxentry{\oxid_1}{\oxsitype_1} \oxdotsc
        \oxvarctxentry{\oxid_n}{\oxsitype_n}}
    }{
      \oxexpr
    }{\oxsitype_f}{\oxvarctx^\prime} \\
    \oxtunify{\oxtvarctx}{\oxkontctx}{\oxemptyctx}{\oxsitype_f}{\oxsitype_r}{\oxemptyctx} \\
  }{
    %% conclusions
    \oxglobalentryvalidity{\oxglobalctx}{
      \oxfuncdef{\oxfnname}{
        \overline{\oxenvvar} \oxcomma \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
      }{
        \oxascribe{\oxid_1}{\oxsitype_1} \oxdotsc
        \oxascribe{\oxid_n}{\oxsitype_n}
      }{\oxsitype_r}{\overline{\oxabsprov_1 : \oxabsprov_2}}{\oxexpr}
    }
  }
}

\newcommand{\WFTupStructDefn}{
  \inferrule[WF-TupleStructDefinition]{
    %% premise
    \oxtvarctx = \overline{\oxtvarctxentry{\oxabsprov}{\oxkprov}} \oxcomma
    \overline{\oxtvarctxentry{\oxtvar}{\oxktype}} \\
    \oxtypevalidity{\oxglobalctx}{\oxtvarctx}{\oxemptyctx}{\oxsitype_1} \\
    \oxdots \\
    \oxtypevalidity{\oxglobalctx}{\oxtvarctx}{\oxemptyctx}{\oxsitype_n} \\
  }{
