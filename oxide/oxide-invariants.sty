\newcommand{\WFVarCtx}{
  \inferrule[WF-StackTyping]{
    %% premises
    \oxvarctxwellformed{\oxglobalctx}{\oxtvarctx}{\oxvarctx} \\
    \oxplaces{\oxframe} \subseteq \oxdomain{\oxnewframe{\oxvarctx}{\oxframe}} \\\\
    \oxrelevant{\oxdomain{\oxframe}}{\oxdomain{\oxvarctx}} \\
    \forall \oxvarctxentry{\oxid}{\oxtype} \in \oxframe. \;
    \oxtypevalidity{\oxglobalctx}{\oxtvarctx}{
      \oxnewframe{\oxvarctx}{\oxframe}
    }{\oxtype} \\\\
    \forall \oxtype \in \oxcodomain{\oxframe}.\
    \forall \oxcprov \in \oxfprovs{\oxtype}.\ \forall \oxtype^\prime \in
    \oxdomain{\oxvarctx}.\ \oxcprov\text{ does not occur outside of a closure in }\oxtype^\prime
    \\\\
    \forall \oxloanctxentry{\oxcprov}{\oxset{\overline{\oxloan}}} \in \oxframe. \;
    \forall \oxloanpkg{\oxmuta}{\oxplaceexpr} \in \oxset{\overline{\oxloan}}.\;
    \exists \oxxitype. \;
    \oxcomputetynoprov{\oxtvarctx}{
      \oxnewframe{\oxvarctx}{\oxframe}
    }{\oxmuta}{\oxplaceexpr}{\oxxitype} \\
  }{
    %% conclusions
    \oxvarctxwellformed{\oxglobalctx}{\oxtvarctx}{\oxnewframe{\oxvarctx}{\oxframe}}
  }
}


