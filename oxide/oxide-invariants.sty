    \oxglobalentryvalidity{\oxglobalctx}{
      \oxtupstructdef{\oxdatatype}{
        \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
      }{\oxsitype_1 \oxdotsc \oxsitype_n}
    }
  }
}

\newcommand{\WFRecStructDefn}{
  \inferrule[WF-RecordStructDefinition]{
    %% premise
    \oxtvarctx = \overline{\oxtvarctxentry{\oxabsprov}{\oxkprov}} \oxcomma
