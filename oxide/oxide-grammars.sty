\newcommand{\oxexpressiongrammar}{
  \bnflabel{Expressions} & \oxexpr & \bnfdef &
  \oxprim \bnfalt \oxplaceexpr \bnfalt
%  \\ && \bnfalt &
  \oxref{\oxcprov}{\oxmuta}{\oxplaceexpr} \bnfalt
  \oxref{\oxcprov}{\oxmuta}{\oxindex{\oxplaceexpr}{\oxexpr}} \bnfalt
  \oxref{\oxcprov}{\oxmuta}{\oxslice{\oxplaceexpr}{\oxexpr_1}{\oxexpr_2}}
  \bnfalt \oxassign{\oxplaceexpr}{\oxexpr} 
  \\ && \bnfalt &
  \oxletrgn{\oxcprov}{\oxexpr} \bnfalt
%  \\ && \bnfalt &
  \oxlet{\oxid}{\oxsitype}{\oxexpr_1}{\oxexpr_2} \bnfalt 
  \oxseq{\oxexpr_1}{\oxexpr_2}
  \\ && \bnfalt &
  \oxclosure{
    \oxascribe{\oxid_1}{\oxsitype_1} \oxdotsc
    \oxascribe{\oxid_n}{\oxsitype_n}
  }{\oxsitype_r}{
    \oxexpr
  } \bnfalt
%  \\ && \bnfalt &
  \oxapp{\oxexpr_f}{
    \overline{\oxenv} \oxcomma \overline{\oxprov} \oxcomma \overline{\oxsitype}
  }{
    \oxexpr_1 \oxdotsc \oxexpr_n
  }
  \\ && \bnfalt &
  \oxbranch{\oxexpr_1}{\oxexpr_2}{\oxexpr_3} \bnfalt
  \oxprod{\oxexpr_1 \oxdotsc \oxexpr_n} \bnfalt
  \oxarr{\oxexpr_1 \oxdotsc \oxexpr_n}
  \\ && \bnfalt &
  \oxindex{\oxplaceexpr}{\oxexpr} \bnfalt
  \oxfor{\oxid}{\oxexpr_1}{\oxexpr_2} \bnfalt
  \oxwhile{\oxexpr_1}{\oxexpr_2} \bnfalt
  \oxabort{\oxstring}
  \\ && \bnfalt &
  \oxinl{\oxsitype_1}{\oxsitype_2}{\oxexpr} \bnfalt \oxinr{\oxsitype_1}{\oxsitype_2}{\oxexpr}
  \\ && \bnfalt &
  \oxmatch{\oxexpr}{\oxid_1}{\oxexpr_1}{\oxid_2}{\oxexpr_2}
}

\newcommand{\oxstructexpressionextension}{
  \\ && \bnfalt &
  \oxrecstruct{
    \oxdatatype \oxsep \oxangle{
      \overline{\oxprov} \oxcomma \overline{\oxsitype}
    }
  }{
    \oxid_1 \oxcolon \oxexpr_1 \oxdotsc \oxid_n \oxcolon \oxexpr_n
  }
  \\ && \bnfalt &
  \oxtupstruct{
    \oxdatatype \oxsep \oxangle{
      \overline{\oxprov} \oxcomma \overline{\oxsitype}
    }
  }{\oxexpr_1 \oxdotsc \oxexpr_n}
}

\newcommand{\oxenumexpressionextension}{
  \\ && \bnfalt &
  \oxmatch{\oxexpr_d}{
    \oxmatcharm{\oxpat_1}{\oxexpr_1} \oxdotsc \oxmatcharm{\oxpat_n}{\oxexpr_n}
  }
  \\ && \bnfalt &
  \oxrecvariant{
    \oxdatatype \oxsep \oxangle{
      \overline{\oxprov} \oxcomma \overline{\oxsitype}
    }
  }{\oxvariant}{
    \oxid_1 \oxcolon \oxexpr_1 \oxdotsc \oxid_n \oxcolon \oxexpr_n
  }
  \\ && \bnfalt &
  \oxtupvariant{
    \oxdatatype \oxsep \oxangle{
      \overline{\oxprov} \oxcomma \overline{\oxsitype}
    }
  }{\oxvariant}{\oxexpr_1 \oxdotsc \oxexpr_n}
}

\newcommand{\oxpatterngrammar}{
  \bnflabel{Patterns} & \oxpat & \bnfdef & \oxpwild
  \\ && \bnfalt &
  \oxptup{\oxid_1 \oxdotsc \oxid_n}
  \\ && \bnfalt &
  \oxptupstruct{\oxdatatype}{\oxid_1 \oxdotsc \oxid_n}
  \\ && \bnfalt &
  \oxprecstruct{\oxdatatype}{
    \oxid_{f_1} \oxcolon \oxid_1 \oxdotsc \oxid_{f_n} \oxcolon \oxid_n
  }
  \\ && \bnfalt &
  \oxptupvariant{\oxdatatype}{\oxvariant}{\oxid_1 \oxdotsc \oxid_n}
  \\ && \bnfalt &
  \oxprecvariant{\oxdatatype}{\oxvariant}{
    \oxid_{f_1} \oxcolon \oxid_1 \oxdotsc \oxid_{f_n} \oxcolon \oxid_n
  }
}

