\newcommand{\oxsitypegrammar}{
  \bnflabel{Sized Types} & \oxsitype & \bnfdef &
  \oxbasetype \bnfalt \oxtvar \bnfalt \oxtref{\oxprov}{\oxmuta}{\oxxitype} 
  \bnfalt \oxtarr{\oxsitype}{\oxnum} \bnfalt \oxtprod{\oxsitype_1 \oxdotsc \oxsitype_n} \bnfalt \oxtsum{\oxsitype_1}{\oxsitype_2}
  \\ && \bnfalt &
  \oxtfunext{
    \overline{\oxenvvar} \oxcomma \overline{\oxabsprov} \oxcomma \overline{\oxtvar}
  }{
    \oxsitype_1 \oxdotsc \oxsitype_n
  }{\oxsitype_r}{\oxenv}{\overline{\oxabsprov_1: \oxabsprov_2}}
}

